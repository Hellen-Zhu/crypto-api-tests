{
  "get_candlestick": {
    "name": "获取K线数据",
    "method": "GET",
    "endpoint": "/exchange/v1/public/get-candlestick",
    "parameters": {
      "type": "query",
      "required": ["instrument_name", "timeframe"],
      "optional": [],
      "schema": {
        "instrument_name": {
          "type": "string",
          "description": "交易对名称"
        },
        "timeframe": {
          "type": "string",
          "description": "时间周期",
          "enum": ["M1", "M5", "M15", "M30", "1H", "4H", "1D", "1W"]
        }
      }
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "assertions": {
      "status_code": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "response_schema": {
        "type": "object",
        "required": ["code", "id", "result"],
        "properties": {
          "code": {"type": "integer"},
          "id": {"type": "integer"},
          "result": {
            "type": "object",
            "required": ["instrument_name", "interval", "data"],
            "properties": {
              "instrument_name": {"type": "string"},
              "interval": {"type": "string"},
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["t", "o", "h", "l", "c", "v"],
                  "properties": {
                    "t": {"type": "integer"},
                    "o": {"type": "string"},
                    "h": {"type": "string"},
                    "l": {"type": "string"},
                    "c": {"type": "string"},
                    "v": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      },
      "business_rules": [
        {
          "rule": "response.result.instrument_name == request.instrument_name",
          "description": "返回的交易对应与请求一致"
        },
        {
          "rule": "response.code == 0",
          "description": "成功响应code为0"
        },
        {
          "rule": "len(response.result.data) > 0",
          "description": "K线数据不为空"
        }
      ]
    },
    "error_assertions": {
      "status_code": [400, 404, 500],
      "response_schema": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "integer", "minimum": 1},
          "message": {"type": "string"}
        }
      },
      "business_rules": [
        {
          "rule": "response.code != 0",
          "description": "错误响应code不为0"
        }
      ]
    }
  },
  "get_tickers": {
    "name": "获取Ticker数据",
    "method": "GET",
    "endpoint": "/exchange/v1/public/get-tickers",
    "parameters": {
      "type": "query",
      "required": ["instrument_name"],
      "optional": [],
      "schema": {
        "instrument_name": {
          "type": "string",
          "description": "交易对名称",
          "pattern": "^[A-Z]+-PERP$"
        }
      }
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "assertions": {
      "status_code": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "response_schema": {
        "type": "object",
        "required": ["code", "id", "method", "result"],
        "properties": {
          "code": {"type": "integer"},
          "id": {"type": "integer"},
          "method": {"type": "string"},
          "result": {
            "type": "object",
            "required": ["data"],
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["i", "h", "l", "a", "v", "vv", "c", "oi", "t"],
                  "properties": {
                    "i": {"type": "string"},
                    "h": {"type": "string"},
                    "l": {"type": "string"},
                    "a": {"type": "string"},
                    "v": {"type": "string"},
                    "vv": {"type": "string"},
                    "c": {"type": "string"},
                    "b": {"type": ["string", "null"]},
                    "k": {"type": ["string", "null"]},
                    "oi": {"type": "string"},
                    "t": {"type": "integer"}
                  }
                }
              }
            }
          }
        }
      },
      "business_rules": [
        {
          "rule": "response.code == 0",
          "description": "成功响应code为0"
        },
        {
          "rule": "len(response._data['result']['data']) > 0",
          "description": "ticker数据不为空"
        },
        {
          "rule": "response._data['result']['data'][0]['i'] == request.instrument_name",
          "description": "返回的交易对应与请求一致"
        }
      ]
    },
    "error_assertions": {
      "status_code": [400, 404, 500],
      "response_schema": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "integer", "minimum": 1},
          "message": {"type": "string"}
        }
      },
      "business_rules": [
        {
          "rule": "response.code != 0",
          "description": "错误响应code不为0"
        }
      ]
    }
  }
}