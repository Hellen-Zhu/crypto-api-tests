{
  "rest_apis": {
    "get_candlestick": {
      "name": "获取K线数据",
      "method": "GET",
      "endpoint": "/exchange/v1/public/get-candlestick",
      "parameters": {
        "type": "query",
        "required": ["instrument_name", "timeframe"],
        "optional": [],
        "schema": {
          "instrument_name": {
            "type": "string",
            "description": "交易对名称"
          },
          "timeframe": {
            "type": "string",
            "description": "时间周期",
            "enum": ["M1", "M5", "M15", "M30", "1H", "4H", "1D", "1W"]
          }
        }
      },
      "headers": {
        "Content-Type": "application/json"
      },
      "assertions": {
        "status_code": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "response_schema": {
          "type": "object",
          "required": ["code", "id", "result"],
          "properties": {
            "code": {"type": "integer"},
            "id": {"type": "integer"},
            "result": {
              "type": "object",
              "required": ["instrument_name", "interval", "data"],
              "properties": {
                "instrument_name": {"type": "string"},
                "interval": {"type": "string"},
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["t", "o", "h", "l", "c", "v"],
                    "properties": {
                      "t": {"type": "integer"},
                      "o": {"type": "string"},
                      "h": {"type": "string"},
                      "l": {"type": "string"},
                      "c": {"type": "string"},
                      "v": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        },
        "business_rules": [
          {
            "rule": "response.result.instrument_name == request.instrument_name",
            "description": "返回的交易对应与请求一致"
          },
          {
            "rule": "response.code == 0",
            "description": "成功响应code为0"
          },
          {
            "rule": "len(response.result.data) > 0",
            "description": "K线数据不为空"
          }
        ]
      },
      "error_assertions": {
        "status_code": [400, 404, 500],
        "response_schema": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "integer", "minimum": 1},
            "message": {"type": "string"}
          }
        },
        "business_rules": [
          {
            "rule": "response.code != 0",
            "description": "错误响应code不为0"
          }
        ]
      }
    }
  },
  "websocket_apis": {
    "subscribe_orderbook": {
      "name": "订阅订单簿",
      "action": "subscribe",
      "channel_template": "book.{instrument_name}.{depth}",
      "parameters": {
        "required": ["instrument_name", "depth"],
        "schema": {
          "instrument_name": {
            "type": "string",
            "description": "交易对名称"
          },
          "depth": {
            "type": "integer",
            "description": "订单簿深度",
            "enum": [5, 10, 20, 50]
          }
        }
      },
      "message_format": {
        "method": "subscribe",
        "params": {
          "channels": ["{{channel}}"]
        },
        "id": "{{timestamp}}"
      },
      "assertions": {
        "subscription_confirmation": {
          "response_schema": {
            "type": "object",
            "required": ["result", "id"],
            "properties": {
              "result": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {"type": "string", "enum": ["ok"]}
                }
              },
              "id": {"type": ["string", "integer"]}
            }
          }
        },
        "data_message": {
          "response_schema": {
            "type": "object",
            "required": ["channel", "data"],
            "properties": {
              "channel": {"type": "string"},
              "data": {
                "type": "object",
                "required": ["bids", "asks", "t"],
                "properties": {
                  "bids": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {"type": "string"},
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "asks": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {"type": "string"},
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "t": {"type": "integer"}
                }
              }
            }
          },
          "business_rules": [
            {
              "rule": "response.channel == request.channel",
              "description": "返回的频道与订阅一致"
            },
            {
              "rule": "len(response.data.bids) <= request.depth",
              "description": "买单深度不超过请求深度"
            },
            {
              "rule": "len(response.data.asks) <= request.depth",
              "description": "卖单深度不超过请求深度"
            }
          ]
        }
      },
      "error_assertions": {
        "subscription_error": {
          "response_schema": {
            "type": "object",
            "required": ["error", "id"],
            "properties": {
              "error": {
                "type": "object",
                "required": ["code", "message"],
                "properties": {
                  "code": {"type": "integer"},
                  "message": {"type": "string"}
                }
              },
              "id": {"type": ["string", "integer"]}
            }
          }
        }
      }
    },
    "unsubscribe_orderbook": {
      "name": "取消订阅订单簿",
      "action": "unsubscribe",
      "channel_template": "book.{instrument_name}.{depth}",
      "parameters": {
        "required": ["instrument_name", "depth"],
        "schema": {
          "instrument_name": {"type": "string"},
          "depth": {"type": "integer"}
        }
      },
      "message_format": {
        "method": "unsubscribe",
        "params": {
          "channels": ["{{channel}}"]
        },
        "id": "{{timestamp}}"
      },
      "assertions": {
        "unsubscription_confirmation": {
          "response_schema": {
            "type": "object",
            "required": ["result", "id"],
            "properties": {
              "result": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {"type": "string", "enum": ["ok"]}
                }
              },
              "id": {"type": ["string", "integer"]}
            }
          }
        }
      }
    }
  }
}